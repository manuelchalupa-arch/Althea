rules_version = '2';

// Althea: cada usuario accede SOLO a su subárbol users/{uid).
// Sin autenticación no hay lectura ni escritura. Sin excepciones.
//
// Feedback: la administración exige email_verified=true y un UID incluido
// en admins/uids. La lista se gestiona EXCLUSIVAMENTE desde Firebase Console
// o Admin SDK; los clientes no pueden crearla, modificarla ni eliminarla.
// No se guardan direcciones de correo administrativas en el repositorio.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // La administración requiere ambas condiciones: correo verificado y
    // UID incluido en la lista privada. El email por sí solo nunca concede rol.
    function isFeedbackAdmin() {
      return signedIn()
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/admins/uids)
        && get(/databases/$(database)/documents/admins/uids).data.uids is list
        && request.auth.uid in get(/databases/$(database)/documents/admins/uids).data.uids;
    }

    function threadPath(threadId) {
      return /databases/$(database)/documents/feedbackThreads/$(threadId);
    }

    // getAfter: permite validar el hilo padre aunque se cree en el MISMO batch
    // que el primer mensaje (get() no ve escrituras del lote en curso).
    function parentOwner(threadId) {
      return getAfter(threadPath(threadId)).data.ownerId;
    }

    // ── Lista de administradores ──────────────────────────────────────────
    match /admins/uids {
      // La lista de roles es privada. isFeedbackAdmin() la consulta desde las
      // reglas; ningún cliente puede leerla ni modificarla directamente.
      allow read, write: if false;
    }

    // ── Conversaciones de feedback ────────────────────────────────────────
    match /feedbackThreads/{threadId} {

      // `resource == null` = el documento no existe: permitir el get evita que
      // una sonda de existencia (getDoc antes de escribir) muera con 403.
      allow get: if signedIn() && (
        resource == null
        || resource.data.ownerId == request.auth.uid
        || isFeedbackAdmin()
      );

      // El cliente dueño SIEMPRE consulta con where('ownerId','==', uid).
      allow list: if signedIn()
        && (resource.data.ownerId == request.auth.uid || isFeedbackAdmin());

      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.category in ['error', 'duda', 'propuesta', 'otro']
        && request.resource.data.status == 'pendiente'
        && request.resource.data.subject is string
        && request.resource.data.subject.size() <= 120
        && request.resource.data.messageCount == 1
        && request.resource.data.unreadForOwner == 0
        && request.resource.data.unreadForAdmin == 1;

      allow update: if signedIn() && (
        // Administrador: puede actualizar estado, contadores y metadatos.
        isFeedbackAdmin()
        // Dueño: solo metadatos de actividad/lectura. Jamás estado, categoría,
        // asunto, propiedad ni borrado.
        || (
          resource.data.ownerId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'updatedAt', 'lastActivityAt', 'lastMessagePreview',
            'lastMessageAuthorRole', 'messageCount',
            'unreadForOwner', 'unreadForAdmin'
          ])
          && request.resource.data.unreadForOwner == 0
        )
      );

      allow delete: if false;

      // ── Mensajes ────────────────────────────────────────────────────────
      match /messages/{messageId} {

        // Mismo criterio que el hilo: leer un mensaje que aún no existe es una
        // sonda legítima del cliente, no un intento de acceso.
        allow get: if signedIn() && (
          resource == null
          || resource.data.ownerId == request.auth.uid
          || isFeedbackAdmin()
        );

        // El dueño lista con where('ownerId','==', uid); el admin sin filtro.
        allow list: if signedIn()
          && (resource.data.ownerId == request.auth.uid || isFeedbackAdmin());

        allow create: if signedIn()
          && request.resource.data.threadId == threadId
          && request.resource.data.ownerId == parentOwner(threadId)
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000
          && (
            (request.resource.data.authorRole == 'user'
              && parentOwner(threadId) == request.auth.uid)
            || (request.resource.data.authorRole == 'admin'
              && isFeedbackAdmin())
          );

        // Mensajes inmutables salvo el flag de lectura del propio lector.
        allow update: if signedIn() && (
          (isFeedbackAdmin()
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['readByAdmin']))
          || (resource.data.ownerId == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['readByOwner']))
        );

        allow delete: if isFeedbackAdmin();
      }

      // ── Notas internas (solo administración) ────────────────────────────
      // Ninguna cuenta normal puede leer ni escribir aquí: ni siquiera el dueño
      // del hilo. Nunca se envían al usuario.
      match /internalNotes/{noteId} {
        allow get, list: if isFeedbackAdmin();
        allow create: if isFeedbackAdmin()
          && request.resource.data.threadId == threadId
          && request.resource.data.authorId == request.auth.uid;
        allow update, delete: if isFeedbackAdmin();
      }
    }

    // ── Grupos privados de CrossFit (Etapa 1) ────────────────────────────
    // Datos compartidos, separados de users/{uid}. La pertenencia es la única
    // autorización: no hay directorio público de grupos ni lectura abierta.
    function groupPath(groupId) {
      return /databases/$(database)/documents/cfGroups/$(groupId);
    }

    function groupExists(groupId) {
      return exists(groupPath(groupId));
    }

    function groupData(groupId) {
      return get(groupPath(groupId)).data;
    }

    function isGroupOwner(groupId) {
      return signedIn()
        && groupExists(groupId)
        && groupData(groupId).ownerId == request.auth.uid;
    }

    function isGroupMember(groupId) {
      return signedIn()
        && groupExists(groupId)
        && request.auth.uid in groupData(groupId).memberIds;
    }

    function invitePath(token) {
      return /databases/$(database)/documents/cfInvites/$(token);
    }

    // El token ES la capacidad: 64 hexadecimales en minúsculas (256 bits).
    function validToken(token) {
      return token is string && token.matches('^[0-9a-f]{64}$');
    }

    // Una invitación solo autoriza a SOLICITAR ingreso: debe existir, ser del
    // grupo, no estar revocada y no haber expirado. Aprobar sigue siendo del
    // propietario.
    function validInvite(token, groupId) {
      return validToken(token)
        && exists(invitePath(token))
        && get(invitePath(token)).data.groupId == groupId
        && get(invitePath(token)).data.revoked == false
        && request.time < get(invitePath(token)).data.expiresAt;
    }

    function groupRequestPath(groupId, uid) {
      return /databases/$(database)/documents/cfGroups/$(groupId)/requests/$(uid);
    }

    // Toda incorporación debe estar respaldada por una solicitud aprobada por
    // el propio entrenador. getAfter permite comprobar el estado de la
    // solicitud dentro de la misma transacción que agrega el integrante.
    // Las bajas (memberIds que se quitan) no requieren ninguna solicitud.
    function addedUid(groupId) {
      return request.resource.data.memberIds.removeAll(resource.data.memberIds)[0];
    }

    function memberAdditionsApproved(groupId) {
      return request.resource.data.memberIds.removeAll(resource.data.memberIds).size() == 0
        || (
          request.resource.data.memberIds.removeAll(resource.data.memberIds).size() == 1
          && existsAfter(groupRequestPath(groupId, addedUid(groupId)))
          && getAfter(groupRequestPath(groupId, addedUid(groupId))).data.status == 'approved'
          && getAfter(groupRequestPath(groupId, addedUid(groupId))).data.groupId == groupId
          && getAfter(groupRequestPath(groupId, addedUid(groupId))).data.reviewedBy == request.auth.uid
        );
    }

    match /cfGroups/{groupId} {
      // Solo integrantes (el propietario siempre está en memberIds).
      allow get: if isGroupMember(groupId);
      // La consulta del cliente filtra por array-contains del propio uid.
      allow list: if signedIn() && request.auth.uid in resource.data.memberIds;

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'id', 'name', 'description', 'schedule', 'ownerId', 'ownerName',
          'memberIds', 'memberNames', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.id == groupId
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.memberIds == [request.auth.uid]
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 60
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 300
        && request.resource.data.schedule is string
        && request.resource.data.schedule.size() <= 80
        && request.resource.data.ownerName is string
        && request.resource.data.ownerName.size() > 0
        && request.resource.data.ownerName.size() <= 80
        && request.resource.data.memberNames is map
        && request.resource.data.createdAt is string
        && request.resource.data.updatedAt is string;

      allow update: if isGroupOwner(groupId)
        && request.resource.data.id == resource.data.id
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.createdAt == resource.data.createdAt
        // El propietario no puede eliminarse a sí mismo ni dejar el grupo sin
        // administración. Tampoco puede haber uids duplicados.
        && request.resource.data.ownerId in request.resource.data.memberIds
        && request.resource.data.memberIds.size() == request.resource.data.memberIds.toSet().size()
        && memberAdditionsApproved(groupId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'description', 'schedule', 'memberIds', 'memberNames', 'updatedAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 60
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 300
        && request.resource.data.schedule is string
        && request.resource.data.schedule.size() <= 80
        && request.resource.data.memberNames is map;

      // El grupo conserva sus datos: no hay borrado desde clientes.
      allow delete: if false;

      // ── Solicitudes de ingreso ─────────────────────────────────────────
      match /requests/{requestUid} {
        // El solicitante ve su propia solicitud; el propietario ve todas.
        allow get: if signedIn()
          && (request.auth.uid == requestUid || isGroupOwner(groupId));
        allow list: if isGroupOwner(groupId);

        allow create: if signedIn()
          && request.resource.data.keys().hasOnly([
            'uid', 'groupId', 'displayName', 'email', 'message', 'status',
            'inviteToken', 'createdAt', 'updatedAt'
          ])
          && requestUid == request.auth.uid
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.groupId == groupId
          && request.resource.data.status == 'pending'
          && request.resource.data.inviteToken is string
          && validInvite(request.resource.data.inviteToken, groupId)
          && groupExists(groupId)
          && !(request.auth.uid in groupData(groupId).memberIds)
          && request.resource.data.displayName is string
          && request.resource.data.displayName.size() > 0
          && request.resource.data.displayName.size() <= 80
          && request.resource.data.email is string
          && request.resource.data.email.size() <= 160
          && request.resource.data.message is string
          && request.resource.data.message.size() <= 300
          && request.resource.data.createdAt is string
          && request.resource.data.updatedAt is string;

        // Solo el propietario revisa. El solicitante únicamente puede volver a
        // 'pending' una solicitud rechazada, con una invitación válida.
        allow update: if (isGroupOwner(groupId)
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.groupId == resource.data.groupId
          && request.resource.data.status in ['approved', 'rejected']
          && request.resource.data.reviewedBy == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'reviewedBy', 'reviewedAt', 'updatedAt'
          ]))
          || (signedIn()
            && request.auth.uid == requestUid
            && resource.data.status == 'rejected'
            && request.resource.data.status == 'pending'
            && request.resource.data.uid == resource.data.uid
            && request.resource.data.groupId == resource.data.groupId
            && request.resource.data.inviteToken is string
            && validInvite(request.resource.data.inviteToken, groupId)
            && !(request.auth.uid in groupData(groupId).memberIds)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status', 'inviteToken', 'message', 'displayName', 'createdAt', 'updatedAt'
            ]));

        allow delete: if false;
      }
    }

    // ── Invitaciones ─────────────────────────────────────────────────────
    // El id del documento ES el token aleatorio de 256 bits. No se puede
    // listar la colección: solo se lee un token exacto que ya se conoce.
    match /cfInvites/{token} {
      allow get: if signedIn() && validToken(token);
      allow list: if signedIn() && resource.data.createdBy == request.auth.uid;

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'groupId', 'groupName', 'createdBy', 'createdAt', 'expiresAt', 'revoked'
        ])
        && validToken(token)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.groupId is string
        && isGroupOwner(request.resource.data.groupId)
        && request.resource.data.groupName is string
        && request.resource.data.groupName.size() > 0
        && request.resource.data.groupName.size() <= 60
        && request.resource.data.revoked == false
        && request.resource.data.expiresAt is timestamp
        // El vencimiento lo impone el servidor: ni vencido ni más allá de 30 días.
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <= request.time + duration.value(30, 'd')
        && request.resource.data.createdAt is string;

      // Revocar es la única modificación permitida, y solo por su creador.
      allow update: if signedIn()
        && resource.data.createdBy == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['revoked', 'revokedAt'])
        && request.resource.data.revoked == true;

      allow delete: if false;
    }

    // Biblioteca compartida: solo el autor puede crear y actualizar su ficha.
    // Un usuario autenticado no puede sobrescribir ejercicios publicados por otro.
    // Los documentos previos sin createdBy quedan legibles pero inmutables.
    match /sharedExercises/{exerciseId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80;
      allow update: if signedIn()
        && resource.data.createdBy == request.auth.uid
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80;
      allow delete: if false;
    }

    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
