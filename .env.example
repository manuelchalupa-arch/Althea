# ALTHEA — plantilla local de variables
# Copiar a .env para desarrollo. Nunca versionar .env reales.
# .env, .env.local, .env.staging, .env.production y .env.*.local están ignorados.

# Firebase Web SDK (valores públicos; las reglas y Auth protegen los datos).
# Producción actual: proyecto althea-4b1d0.
VITE_FIREBASE_API_KEY=REEMPLAZAR_FIREBASE_WEB_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=REEMPLAZAR_PROYECTO.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=REEMPLAZAR_FIREBASE_PROJECT_ID
VITE_FIREBASE_STORAGE_BUCKET=REEMPLAZAR_PROYECTO.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=REEMPLAZAR_SENDER_ID
VITE_FIREBASE_APP_ID=REEMPLAZAR_APP_ID

# Web Push: clave pública VAPID. Vacía = la aplicación funciona sin push.
VITE_FIREBASE_VAPID_KEY=

# Proxy de IA de Althea.
# El nombre VITE_GROQ_PROXY_URL se conserva por compatibilidad con el cliente.
# El destino vigente es un Cloudflare Worker que invoca Workers AI mediante
# el binding AI. No se usa api.groq.com ni se requiere GROQ_API_KEY.
# Staging:    https://althea-proxy-staging.manuelchalupa.workers.dev
# Producción: https://althea-proxy-production.manuelchalupa.workers.dev
VITE_GROQ_PROXY_URL=https://REEMPLAZAR_WORKER.workers.dev

# Identidades de entorno usadas por scripts de validación/despliegue.
# No son variables VITE_* y no se incluyen en el bundle.
FIREBASE_STAGING_PROJECT_ID=althea-stg
FIREBASE_PRODUCTION_PROJECT_ID=althea-4b1d0
